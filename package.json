{
  "name": "ktoon-ai-index",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "bin": {
    "ai-index": "./bin/ai-index.js"
  },
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "ai-index": "tsx src/cli/index.ts",
    "prebuild": "npm run build:content",
    "build": "vite build",
    "build:content": "tsx scripts/build-content.ts",
    "verify:content": "tsx scripts/build-content.ts --check",
    "verify:release": "tsx scripts/check-release-package.ts",
    "verify:github-sandbox": "tsx scripts/verify-github-sandbox.ts",
    "verify": "npm run format:check && npm run typecheck && npm test && npm run verify:content && npm run build && npm run verify:release",
    "format": "prettier --write src scripts tests/*.ts bin/*.js .github/workflows/*.yml vite.config.ts package.json tsconfig.json 'skills/**/*.{md,yaml}'",
    "format:check": "prettier --check src scripts tests/*.ts bin/*.js .github/workflows/*.yml vite.config.ts package.json tsconfig.json 'skills/**/*.{md,yaml}'",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.3.0",
    "vue": "^3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "parse5": "^8.0.1",
    "postcss": "^8.5.26",
    "postcss-value-parser": "^4.2.0",
    "prettier": "^3.6.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^3.0.0"
  }
}
